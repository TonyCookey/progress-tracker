DATABASE_URL="postgresql://user:password@localhost:5432/yourdb"
NEXTAUTH_SECRET="your-secret"
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PASSWORD=

# Cloudflare R2 (image storage)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Resend (transactional email — password reset, future notifications)
RESEND_API_KEY=
EMAIL_FROM="DA Progress Tracker <no-reply@yourdomain.com>"

# Daily birthday/anniversary emails (Vercel Cron -> /api/cron/greetings)
# Any long random string; Vercel sends it as a Bearer token. Route refuses to run without it.
CRON_SECRET=
# Timezone used to decide what "today" is (default Africa/Lagos)
APP_TIMEZONE=Africa/Lagos
